generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Existing foundation rows remain valid; only capability-backed rows can resume.
model GameSession {
  id               String               @id @default(uuid()) @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tokenDigest      String?              @unique
  narrativeVersion String?
  state            Json?
  revision         Int                  @default(0)
  expiresAt        DateTime?
  receipts         GameCommandReceipt[]
  checkpoints      GameCheckpoint[]
  consultationSlots GameConsultationSlot[]
  pendingGeneration GamePendingGeneration?
}

model GameCommandReceipt {
  sessionId       String      @db.Uuid
  commandId       String      @db.Uuid
  requestDigest   String
  appliedRevision Int
  generationStatus String?
  generationReason String?
  createdAt       DateTime    @default(now())
  session         GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, commandId])
}

model GameCheckpoint {
  sessionId    String      @db.Uuid
  checkpointId String
  snapshot     Json
  createdAt    DateTime    @default(now())
  session      GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, checkpointId])
}

model GameConsultationSlot {
  sessionId     String      @db.Uuid
  encounterId   String
  slotIndex     Int
  category      String
  localizedText Json
  recipe        Boolean
  createdAt     DateTime    @default(now())
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, encounterId, slotIndex])
}

// One outstanding server-owned reservation per session. No network call is made
// under the session lock. Expired reservations finalize with authored fallback.
model GamePendingGeneration {
  sessionId     String      @id @db.Uuid
  commandId     String      @db.Uuid
  requestDigest String
  nextState     Json
  request       Json
  deadlineAt    DateTime
  createdAt     DateTime    @default(now())
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Small public portfolio admission budget (UTC days); no personal data or IP.
model PublicDailyUsage {
  day           DateTime @id @db.Date
  sessions      Int      @default(0)
  modelRequests Int      @default(0)
}
