generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Existing foundation rows remain valid; only capability-backed rows can resume.
model GameSession {
  id               String               @id @default(uuid()) @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tokenDigest      String?              @unique
  narrativeVersion String?
  state            Json?
  revision         Int                  @default(0)
  expiresAt        DateTime?
  receipts         GameCommandReceipt[]
  checkpoints      GameCheckpoint[]
  consultationSlots GameConsultationSlot[]
}

model GameCommandReceipt {
  sessionId       String      @db.Uuid
  commandId       String      @db.Uuid
  requestDigest   String
  appliedRevision Int
  createdAt       DateTime    @default(now())
  session         GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, commandId])
}

model GameCheckpoint {
  sessionId    String      @db.Uuid
  checkpointId String
  snapshot     Json
  createdAt    DateTime    @default(now())
  session      GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, checkpointId])
}

model GameConsultationSlot {
  sessionId     String      @db.Uuid
  encounterId   String
  slotIndex     Int
  category      String
  localizedText Json
  recipe        Boolean
  createdAt     DateTime    @default(now())
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, encounterId, slotIndex])
}
