{
  "openapi": "3.1.0",
  "info": {
    "title": "AMI-108 Game API",
    "version": "0.1.0-local",
    "description": "Implemented five-chapter game contract through the same-origin Next.js facade and authoritative NestJS API, including public-mode daily session admission limits. Pending inference resolves to approved text or authored fallback. Hosted verification and limitations are recorded separately in release readiness."
  },
  "servers": [
    {
      "url": "/api/game"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/session": {
      "post": {
        "operationId": "createSession",
        "summary": "Start a new run and issue a scoped session cookie",
        "description": "Create a new run only on explicit player action; do not silently overwrite an existing run on resume. Initial projection starts at the first chapter card.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSession"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Projection"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Opaque session capability, HttpOnly, Secure in production, SameSite; never returned in response JSON.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected origin (empty facade response), or unauthorized action (JSON error from API).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Game route disabled; empty facade response."
          },
          "413": {
            "description": "Facade rejects body over 2048 bytes; empty response."
          },
          "415": {
            "description": "Facade requires application/json; empty response."
          },
          "429": {
            "description": "Public daily new-session quota exhausted (CAPACITY_LIMIT). Existing saves remain accessible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/view": {
      "get": {
        "operationId": "getView",
        "summary": "Resume or read the current authorized view",
        "responses": {
          "200": {
            "description": "Current localized view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Projection"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Game route disabled; empty facade response."
          },
          "409": {
            "description": "Saved narrative version mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/commands": {
      "post": {
        "operationId": "executeCommand",
        "summary": "Execute one currently allowed action",
        "description": "Identical duplicate commands wait or replay the current view; conflicts return 409. New actions require the current revision and authorized action ID. Pending generation is finalized within its deadline or falls back; no HTTP 202 response.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied or replayed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected origin (empty facade response), or unauthorized action (JSON error from API).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Game route disabled; empty facade response."
          },
          "409": {
            "description": "Stale revision, pending command or conflicting idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Facade rejects body over 2048 bytes; empty response."
          },
          "415": {
            "description": "Facade requires application/json; empty response."
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/locale": {
      "patch": {
        "operationId": "changeLocale",
        "summary": "Change the presentation language, without changing gameplay",
        "description": "No reroll, extra debit or extra inference; use localized fallback for a missing cached translation. Identical retry is idempotent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeLocale"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected origin (empty facade response), or unauthorized action (JSON error from API).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Game route disabled; empty facade response."
          },
          "409": {
            "description": "Stale revision, pending command or conflicting idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Facade rejects body over 2048 bytes; empty response."
          },
          "415": {
            "description": "Facade requires application/json; empty response."
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/asset": {
      "get": {
        "operationId": "getCurrentAsset",
        "summary": "Fetch image for the current authorized view",
        "description": "Derive image ID from the current visible step and require an exact matching cache discriminator; reject absent, stale or future keys. Return private, no-store bytes; no public catalog.",
        "responses": {
          "200": {
            "description": "Authorized scene image",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, malformed, stale or unauthorized key; facade can return an empty response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Saved narrative version mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^CENA-[0-9]{2}$"
            },
            "description": "Current-image cache discriminator; must equal the asset authorized by session state. Does not select arbitrary art."
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ami_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "CONTINUE",
              "INTERACT",
              "PREVIOUS",
              "CONSULT",
              "CHOOSE",
              "RETRY"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "label"
        ]
      },
      "Diagnostics": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "energy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "med": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "bio": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "hist": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "personal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "personalUnlocked": {
            "type": "boolean"
          }
        },
        "required": [
          "energy",
          "med",
          "bio",
          "hist",
          "personal",
          "personalUnlocked"
        ]
      },
      "Asset": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^/api/game/asset\\?key=CENA-[0-9]{2}$"
          },
          "alt": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "alt"
        ]
      },
      "Projection": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "locale": {
            "type": "string",
            "enum": [
              "pt-BR",
              "en"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "CHAPTER_CARD",
              "NARRATIVE",
              "FLASHBACK",
              "ENCOUNTER",
              "DEAD"
            ]
          },
          "chapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "chapterTitle": {
            "type": "string",
            "minLength": 1
          },
          "sceneId": {
            "type": "string"
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "asset": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Asset"
              },
              {
                "type": "null"
              }
            ]
          },
          "diagnostics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Diagnostics"
              },
              {
                "type": "null"
              }
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          },
          "pending": {
            "type": "boolean",
            "const": false,
            "description": "Completed current projection. Server waits outside transaction for pending reservation to finalize."
          },
          "narration": {
            "type": "boolean",
            "description": "Narrative description rather than dialogue or tutorial."
          },
          "information": {
            "type": "boolean",
            "description": "True for the tutorial information card, distinct from narration and dialogue."
          },
          "cue": {
            "type": "string",
            "enum": [
              "none",
              "pain",
              "ellipsis",
              "wake",
              "memory-cut",
              "fade-black",
              "close-eyes",
              "startle",
              "blink-black",
              "fade-in",
              "memory-shiver",
              "name-reveal",
              "energy-reveal",
              "archive-record",
              "crt-reveal",
              "crt-startle",
              "disoriented",
              "f3-count"
            ],
            "description": "Presentation cue for current authored beat only; no game-state effect."
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "number",
                "title"
              ]
            },
            "description": "Only chapters reached by this session, including earlier chapters after replay. No future chapter titles."
          },
          "complete": {
            "type": "boolean",
            "description": "Optional Chapter 5 completion marker; credits have complete=true and no actions."
          }
        },
        "required": [
          "revision",
          "locale",
          "phase",
          "chapter",
          "chapterTitle",
          "sceneId",
          "speaker",
          "text",
          "asset",
          "diagnostics",
          "actions",
          "pending",
          "cue",
          "narration",
          "information",
          "chapters"
        ]
      },
      "CreateSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "pt-BR",
              "en"
            ]
          }
        },
        "required": [
          "locale"
        ]
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483646
          },
          "actionId": {
            "type": "string",
            "minLength": 1,
            "description": "Current authorized action ID or CHAPTER/RESTART/N for a previously unlocked chapter. Server validates progress and revision.",
            "maxLength": 120
          }
        },
        "required": [
          "commandId",
          "expectedRevision",
          "actionId"
        ]
      },
      "ChangeLocale": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483646
          },
          "locale": {
            "type": "string",
            "enum": [
              "pt-BR",
              "en"
            ]
          }
        },
        "required": [
          "commandId",
          "expectedRevision",
          "locale"
        ]
      },
      "CommandResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "APPLIED",
              "REPLAYED"
            ]
          },
          "view": {
            "$ref": "#/components/schemas/Projection"
          }
        },
        "required": [
          "commandId",
          "status",
          "view"
        ]
      }
    }
  }
}
