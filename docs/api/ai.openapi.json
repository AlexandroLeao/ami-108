{
  "openapi": "3.1.0",
  "info": {
    "title": "AMI-108 Internal AI API",
    "version": "0.1.0-local",
    "description": "Implemented internal FastAPI contract. Authenticated server-to-server only. Q-BOAR is recognized on the wire but always denied by retrieval; Chapter 5 consultations are authored in NestJS. Provider selection and deadline fallback never determine game state."
  },
  "paths": {
    "/internal/generate": {
      "post": {
        "operationId": "generateUtterance",
        "summary": "Generate validated wording or request authored fallback",
        "description": "Requires configured bearer token and JSON body up to 8192 bytes. Validate exact question/category/fact set; unauthorized context returns FALLBACK_REQUIRED, not a new model prompt. No player identity or game-state mutation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated candidate or fallback signal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResult"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON, invalid input, unsupported content type or body over 8192 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing, incorrect or unconfigured internal token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "GenerationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "questionId": {
            "type": "string",
            "enum": [
              "Q-DOG",
              "Q-RAT",
              "Q-BOAR",
              "INTRO-RANDOM"
            ],
            "description": "Q-BOAR is accepted by the request parser but returns UNAUTHORIZED_CONTEXT. Eligible contexts: INTRO-RANDOM, Q-DOG and Q-RAT, with exact authorized categories and fact sets."
          },
          "category": {
            "type": "string",
            "enum": [
              "CORRECT",
              "RANDOM"
            ]
          },
          "locale": {
            "type": "string",
            "enum": [
              "pt-BR",
              "en"
            ]
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "uniqueItems": true,
            "maxItems": 12
          },
          "deadlineMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000,
            "description": "Wire limit 1–30000 ms. Gameplay adapter uses at most 2500 ms, Ollama transport 2000 ms; diagnostic requests can differ."
          }
        },
        "required": [
          "requestId",
          "questionId",
          "category",
          "locale",
          "factIds",
          "deadlineMs"
        ]
      },
      "GenerationResult": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "const": "VALIDATED"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "requestId",
              "status",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "const": "FALLBACK_REQUIRED"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "UNAVAILABLE",
                  "TIMEOUT",
                  "INVALID_OUTPUT",
                  "BUDGET_EXCEEDED",
                  "UNAUTHORIZED_CONTEXT"
                ]
              }
            },
            "required": [
              "requestId",
              "status",
              "reason"
            ]
          }
        ]
      }
    },
    "securitySchemes": {
      "internalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Private AMI_AI_INTERNAL_TOKEN; never exposed to browser"
      }
    }
  },
  "servers": [
    {
      "url": "http://ai:8000",
      "description": "Internal Compose service, not a public URL"
    }
  ],
  "security": [
    {
      "internalBearer": []
    }
  ]
}
