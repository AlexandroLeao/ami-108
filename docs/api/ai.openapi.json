{
  "openapi": "3.1.0",
  "info": {
    "title": "AMI-108 Internal AI API",
    "version": "0.1.0-proposed",
    "description": "Internal-only service. NestJS owns authorization, category, budget, state and fallbacks. No client prompt, player identity, game-state mutation or arbitrary fact text is accepted."
  },
  "paths": {
    "/internal/generate": {
      "post": {
        "operationId": "generateUtterance",
        "summary": "Generate validated wording or request authored fallback",
        "description": "Check question/category/fact IDs against allowlist. No future facts or external calls beyond approved budget. A returned candidate is not an authoritative game decision; NestJS enforces deadline and fallback.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated candidate or fallback signal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Action not authorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "GenerationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "questionId": {
            "type": "string",
            "enum": [
              "Q-DOG",
              "Q-RAT",
              "Q-BOAR",
              "INTRO-RANDOM"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "CORRECT",
              "RANDOM"
            ]
          },
          "locale": {
            "type": "string",
            "enum": [
              "pt-BR",
              "en"
            ]
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 12
          },
          "deadlineMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          }
        },
        "required": [
          "requestId",
          "questionId",
          "category",
          "locale",
          "factIds",
          "deadlineMs"
        ]
      },
      "GenerationResult": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "const": "VALIDATED"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "requestId",
              "status",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "const": "FALLBACK_REQUIRED"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "UNAVAILABLE",
                  "TIMEOUT",
                  "INVALID_OUTPUT",
                  "BUDGET_EXCEEDED",
                  "UNAUTHORIZED_CONTEXT"
                ]
              }
            },
            "required": [
              "requestId",
              "status",
              "reason"
            ]
          }
        ]
      }
    }
  }
}
