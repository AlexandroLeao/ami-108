{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/server.cjs",
      "outputDirectory": ".",
      "bindings": [
        {
          "type": "service",
          "service": "ai",
          "format": "url",
          "env": "AI_SERVICE_URL"
        }
      ],
      "functions": {
        "src/server.cjs": {
          "includeFiles": "assets/scenes/*.png"
        }
      }
    },
    "ai": {
      "root": "services/ai",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
