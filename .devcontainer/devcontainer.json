{
  "name": "AMI-108",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "sudo corepack enable && pipx install uv",
  "forwardPorts": [
    3000,
    3001,
    8000
  ],
  "portsAttributes": {
    "3000": {
      "label": "AMI-108 Web",
      "onAutoForward": "notify"
    },
    "3001": {
      "label": "Game API",
      "onAutoForward": "silent"
    },
    "8000": {
      "label": "AI service",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "charliermarsh.ruff",
        "Prisma.prisma"
      ]
    }
  }
}
