# Local Compose only. Replace before use; never reuse for production.
POSTGRES_USER=ami
POSTGRES_PASSWORD=replace-local-password
POSTGRES_DB=ami

# Optional internal generation reservation; disabled by default. No real provider configured.
AMI_AI_GENERATION=0
AMI_AI_INTERNAL_TOKEN=

# Explicit provider selector: empty (fallback), ollama (local), cloudflare (remote).
# Keeping AMI_AI_GENERATION=0 prevents API-side provider calls.
AMI_AI_PROVIDER=

# Ollama: previous VM verified Qwen2.5:1.5b; do not pull automatically.
AMI_OLLAMA_URL=
AMI_OLLAMA_MODEL=

# Remote Workers AI: DO NOT populate or activate without owner approval of
# Cloudflare data disclosure and account Free/eligibility. Never commit real keys.
# Strict model allowlist enforced in cloudflare_provider.py.
AMI_CLOUDFLARE_ACCOUNT_ID=
AMI_CLOUDFLARE_API_TOKEN=
AMI_CLOUDFLARE_MODEL=
